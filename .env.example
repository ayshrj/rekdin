# Site / SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter defaults / optional server fallback
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=

# Provider keys for local scripts or manual testing.
# The app UI persists provider credentials through Settings, so these are not required for normal UI use.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Logging
SHOW_LOGS=false
NEXT_PUBLIC_SHOW_LOGS=false

# Local data storage
REKDIN_DATA_DIR=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Captcha solving (optional)
CAPTCHA_SOLVER_TOKEN=
RECAPTCHA_SOLVER_TOKEN=

# Playwright/manual verification scripts (optional)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001
OPENROUTER_TEST_KEY=

# Demo repo variables (only needed if running demo-repo directly)
PORT=4000
DATABASE_URL=postgres://demo:demo@localhost:5432/demo_repo
JWT_SECRET=development-secret
ADMIN_TOKEN=let-me-in
CORS_ORIGIN=*
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=10

# Note:
# Claude / Grok / Azure OpenAI credentials are configured through the app settings store,
# not read directly from environment variables in this codebase.
